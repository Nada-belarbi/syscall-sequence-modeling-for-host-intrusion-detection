# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
*.whl

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
.env

# ── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints/

# ── Large binary / processed data (re-generated by the pipeline) ─────────────
# .npy, .pkl, .parquet in data/processed/ are derived artefacts — regenerate
# with notebooks 01-02. Results CSVs and report figures ARE committed.
data/processed/**/*.npy
data/processed/**/*.pkl
data/processed/**/*.parquet

# ── Model checkpoints (large, regenerable) ───────────────────────────────────
results/logs/checkpoints/*.pt
results/logs/checkpoints/*.pth

# ── OS / editor junk ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/settings.json

# ── Secrets / credentials ────────────────────────────────────────────────────
.env
*.pem
*.key
secrets.yaml
